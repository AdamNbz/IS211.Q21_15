services:
  zero1:
    image: dgraph/dgraph:latest
    container_name: dgraph_zero1
    ports:
      - "5080:5080"
      - "6080:6080"
    volumes:
      - ./dgraph_data/zero1:/dgraph
    restart: on-failure
    # TODO: Thay YOUR_TAILSCALE_IP bằng IP Tailscale của máy chạy Dgraph Zero.
    command: dgraph zero --my=YOUR_TAILSCALE_IP:5080 --replicas 1

  alpha1:
    image: dgraph/dgraph:latest
    container_name: dgraph_alpha1
    ports:
      - "8080:8080"
      - "9080:9080"
      - "7080:7080"
    volumes:
      - ./dgraph_data/alpha1:/dgraph
    restart: on-failure
    # TODO: Thay YOUR_TAILSCALE_IP bằng IP Tailscale của máy chạy Dgraph Alpha/Zero.
    command: dgraph alpha --my=YOUR_TAILSCALE_IP:7080 --zero=YOUR_TAILSCALE_IP:5080 --bindall=true --security "whitelist=0.0.0.0/0"
    depends_on:
      - zero1

  ratel:
    image: dgraph/ratel:latest
    # macOS Apple Silicon: giữ linux/amd64 vì image ratel không khớp host linux/arm64/v8.
    # Windows/Linux x86_64: có thể xóa dòng platform bên dưới.
    platform: linux/amd64
    container_name: dgraph_ratel
    ports:
      - "8000:8000"
    restart: on-failure
    depends_on:
      - alpha1
